	partition 'marts fct_event_impact' = m
		mode: import
		source =
				let
				  Source = PostgreSQL.Database("localhost", "cdpr_hub"),
				  #"Navigation 1" = Source{[Schema = "marts", Item = "fct_event_impact"]}[Data],
				  // Attributes the Event dimension already carries. One copy per attribute,
				  // in Event, keeps a single source of truth for the model.
				  #"Removed duplicated columns" = Table.RemoveColumns(#"Navigation 1", {"event_date", "event_type", "magnitude", "event_name", "is_platform_wide"}),
				  // An unconstrained PostgreSQL numeric arrives as a floating point Double.
				  // Fixed decimal (Currency.Type) holds these values exactly and compresses
				  // better, which is what the model wants for ratios and averages.
				  #"Changed column types" = Table.TransformColumnTypes(
				    #"Removed duplicated columns",
				    {
				      {"reviews_per_day_pre", Currency.Type},
				      {"reviews_per_day_2w", Currency.Type},
				      {"reviews_per_day_4_8w", Currency.Type},
				      {"reviews_uplift_2w_pct", Currency.Type},
				      {"reviews_uplift_4_8w_pct", Currency.Type},
				      {"control_reviews_uplift_2w_pct", Currency.Type},
				      {"net_reviews_uplift_2w_pct", Currency.Type},
				      {"net_reviews_uplift_4_8w_pct", Currency.Type},
				      {"steam_score_pre", Currency.Type},
				      {"steam_score_2w", Currency.Type},
				      {"score_change_2w_pp", Currency.Type},
				      {"control_score_change_2w_pp", Currency.Type},
				      {"net_score_change_2w_pp", Currency.Type},
				      {"avg_players_pre", Currency.Type},
				      {"avg_players_2w", Currency.Type},
				      {"players_uplift_2w_pct", Currency.Type},
				      {"net_players_uplift_2w_pct", Currency.Type}
				    }
				  )
				in
				  #"Changed column types"

