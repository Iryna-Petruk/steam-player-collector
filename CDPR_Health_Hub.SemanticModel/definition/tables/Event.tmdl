/// Календар подій із посиланнями на джерела: виходи, патчі, DLC, розпродажі, екранізації. Для одноденної події end_date дорівнює event_date.
table Event
	lineageTag: ed2f62f3-8686-4da9-8273-664e8bc39917

	column event_id
		dataType: string
		isHidden
		isKey
		isAvailableInMdx: false
		lineageTag: 66a7c804-8fa3-4cab-8c75-70fc5a3d1d35
		summarizeBy: none
		sourceColumn: event_id

		annotation SummarizationSetBy = Automatic

	/// Дата початку події.
	column event_date
		dataType: dateTime
		formatString: Long Date
		lineageTag: 09cbb344-dd52-4174-9acd-6b3879e4d8cc
		summarizeBy: none
		sourceColumn: event_date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// Дата завершення події; для одноденної дорівнює даті початку.
	column end_date
		dataType: dateTime
		formatString: Long Date
		lineageTag: 457ee645-7890-45ec-b314-1f8feba95593
		summarizeBy: none
		sourceColumn: end_date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// Тривалість події в днях, включно з першим і останнім днем.
	column duration_days
		dataType: int64
		formatString: 0
		lineageTag: acb10082-5e0c-41ef-8867-87025b44956e
		summarizeBy: none
		sourceColumn: duration_days

		annotation SummarizationSetBy = Automatic

	/// Steam appid гри, якої стосується подія. Порожньо для подій на всю платформу.
	column appid
		dataType: int64
		formatString: 0
		lineageTag: 3319f705-1e98-4632-a616-e14d540ce8ec
		summarizeBy: none
		sourceColumn: appid

		annotation SummarizationSetBy = Automatic

	/// Чи подія стосується всього Steam (напр. сезонний розпродаж), а не однієї гри.
	column is_platform_wide
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 5cd05622-64d8-4fed-8dff-ba0420643486
		summarizeBy: none
		sourceColumn: is_platform_wide

		annotation SummarizationSetBy = Automatic

	/// Назва гри, якої стосується подія.
	column game
		dataType: string
		lineageTag: 25734a48-7dfb-451c-8809-e9722b08b788
		summarizeBy: none
		sourceColumn: game

		annotation SummarizationSetBy = Automatic

	/// Тип події: вихід, патч, DLC, розпродаж тощо.
	column event_type
		dataType: string
		lineageTag: 053a83e0-54a7-451a-81a8-e15e9a07d6b9
		summarizeBy: none
		sourceColumn: event_type

		annotation SummarizationSetBy = Automatic

	/// Назва події для показу у звіті.
	column event_name
		dataType: string
		lineageTag: 70a3ca8a-db5b-440c-97e7-08425aad3604
		summarizeBy: none
		sourceColumn: event_name

		annotation SummarizationSetBy = Automatic

	/// Масштаб події: major або minor.
	column magnitude
		dataType: string
		lineageTag: 3ee7383c-be8b-4f7a-9e12-43f71adfb7a2
		summarizeBy: none
		sourceColumn: magnitude

		annotation SummarizationSetBy = Automatic

	/// Посилання на джерело, яким підтверджено подію та її дату.
	column source_url
		dataType: string
		lineageTag: 8e3bd5fb-9c49-4f60-aeca-eee32361db8d
		summarizeBy: none
		sourceColumn: source_url

		annotation SummarizationSetBy = Automatic

	/// Вільна примітка до події.
	column notes
		dataType: string
		lineageTag: 656d580f-f0b7-4610-ba3b-4948ead5b356
		summarizeBy: none
		sourceColumn: notes

		annotation SummarizationSetBy = Automatic

	/// Порядок показу типів подій у візуалах: 1 Release, 2 Major update, 3 Patch, 4 Expansion, 5 Transmedia, 6 Platform sale, 7 Announcement, 8 Related release, 9 Other. Службова колонка сортування для event_type_label; прихована, окремо у звіті не використовується.
	column event_type_sort =
			SWITCH (
				'Event'[event_type],
				"release", 1,
				"major_update", 2,
				"patch", 3,
				"expansion", 4,
				"transmedia", 5,
				"platform_sale", 6,
				"announcement", 7,
				"related_release", 8,
				"other", 9,
				9
			)
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 45b6254b-3465-46fc-844c-eb30250ff680
		summarizeBy: none

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["FIRST_LETTER_OF_OBJECTS_MUST_BE_CAPITALIZED"]}

		annotation SummarizationSetBy = Automatic

	/// Підпис типу події для показу у звіті: Release, Major update, Patch, Expansion, Transmedia, Platform sale, Announcement, Related release, Other. Сортується колонкою event_type_sort у цьому порядку. Перелік повторює тест dbt accepted_values для stg_events.event_type і EVENT_TYPES у collector/validate_events.py — змінювати треба разом із ними; будь-яке інше значення отримує підпис Other.
	column event_type_label =
			SWITCH (
				'Event'[event_type],
				"release", "Release",
				"major_update", "Major update",
				"patch", "Patch",
				"expansion", "Expansion",
				"transmedia", "Transmedia",
				"platform_sale", "Platform sale",
				"announcement", "Announcement",
				"related_release", "Related release",
				"other", "Other",
				"Other"
			)
		dataType: string
		lineageTag: 1fe7cd3d-9151-467e-b8d4-09f7374351c1
		summarizeBy: none
		sortByColumn: event_type_sort

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["FIRST_LETTER_OF_OBJECTS_MUST_BE_CAPITALIZED"]}

		annotation SummarizationSetBy = Automatic

	partition 'marts dim_events' = m
		mode: import
		source =
				let
				  Source = PostgreSQL.Database("localhost", "cdpr_hub"),
				  #"Navigation 1" = Source{[Schema = "marts", Item = "dim_events"]}[Data]
				in
				  #"Navigation 1"

	annotation PBI_ResultType = Table

