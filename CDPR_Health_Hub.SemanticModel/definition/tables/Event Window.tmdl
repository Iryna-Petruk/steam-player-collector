	partition 'marts fct_event_window' = m
		mode: import
		source =
				let
				  Source = PostgreSQL.Database("localhost", "cdpr_hub"),
				  #"Navigation 1" = Source{[Schema = "marts", Item = "fct_event_window"]}[Data],
				  // appid and event_date duplicate what Game (via target_appid) and Event
				  // already provide; nothing in the model or the report reads them here.
				  #"Removed duplicated columns" = Table.RemoveColumns(#"Navigation 1", {"appid", "event_date"}),
				  // An unconstrained PostgreSQL numeric arrives as a floating point Double.
				  // Fixed decimal (Currency.Type) holds these values exactly and compresses
				  // better, which is what the model wants for ratios and averages.
				  #"Changed column types" = Table.TransformColumnTypes(
				    #"Removed duplicated columns",
				    {
				      {"reviews_index", Currency.Type},
				      {"players_index", Currency.Type}
				    }
				  )
				in
				  #"Changed column types"

