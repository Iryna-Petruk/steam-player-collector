/// Календар на 2015-2027 роки. Позначений як таблиця дат: на нього спирається вся часова логіка мір і група обчислень Time Window.
table Date
	lineageTag: 4c19f4ba-db2e-434a-a5d7-480a5ff72b97
	dataCategory: Time

	/// Дата (день). Ключ таблиці дат і поле зрізу періоду у звіті.
	column date
		dataType: dateTime
		isUnique
		isKey
		formatString: Long Date
		lineageTag: 7c925866-78d8-4f54-8eb4-b2e12bbb4944
		summarizeBy: none
		sourceColumn: date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["HIDE_FOREIGN_KEYS"]}

	/// Рік числом, напр. 2026.
	column year
		dataType: int64
		formatString: 0
		lineageTag: a78e1563-7598-4d27-b1c2-ec3a38c2e4e6
		summarizeBy: none
		sourceColumn: year

		annotation SummarizationSetBy = Automatic

	/// Номер квартала, 1-4.
	column quarter
		dataType: int64
		formatString: 0
		lineageTag: a8dbcf2b-76a5-4d59-bf74-65e87b000c49
		summarizeBy: none
		sourceColumn: quarter

		annotation SummarizationSetBy = Automatic

	/// Підпис квартала, напр. Q4.
	column quarter_name
		dataType: string
		lineageTag: 6388a882-8c7b-4728-8d2e-3a2fcb5e711e
		summarizeBy: none
		sourceColumn: quarter_name
		sortByColumn: quarter

		annotation SummarizationSetBy = Automatic

	/// Номер місяця, 1-12.
	column month
		dataType: int64
		formatString: 0
		lineageTag: 85cee347-8bc0-400e-b3d9-fba35bdb06af
		summarizeBy: none
		sourceColumn: month

		annotation SummarizationSetBy = Automatic

	/// Скорочена назва місяця, напр. Nov; сортується за номером місяця.
	column month_name
		dataType: string
		lineageTag: c1c5e816-3c72-45fb-bdfd-7d41163c5d38
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: month

		annotation SummarizationSetBy = Automatic

	/// Рік і місяць як текст YYYY-MM, напр. 2026-11. Такий формат сортується правильно сам по собі, тому окрема колонка сортування не потрібна.
	column year_month
		dataType: string
		lineageTag: bdefd33b-d46c-47cc-a71e-f4f3b9cc73b9
		summarizeBy: none
		sourceColumn: year_month

		annotation SummarizationSetBy = Automatic

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["MONTH_(AS_A_STRING)_MUST_BE_SORTED"]}

	/// Рік за ISO 8601: на межі року може відрізнятися від календарного.
	column iso_year
		dataType: int64
		formatString: 0
		lineageTag: 8f87b995-4c4d-42d4-9344-dcd6a1885b92
		summarizeBy: none
		sourceColumn: iso_year

		annotation SummarizationSetBy = Automatic

	/// Номер тижня за ISO 8601.
	column iso_week
		dataType: int64
		formatString: 0
		lineageTag: e4d1c2fb-05bb-4c09-a81d-7e73187f6c2b
		summarizeBy: none
		sourceColumn: iso_week

		annotation SummarizationSetBy = Automatic

	/// Номер дня тижня, 1 = понеділок.
	column weekday_number
		dataType: int64
		formatString: 0
		lineageTag: 2a92ec1f-dd49-4276-a64d-e157c92f823c
		summarizeBy: none
		sourceColumn: weekday_number

		annotation SummarizationSetBy = Automatic

	/// Скорочена назва дня тижня, напр. Mon; сортується за номером дня.
	column weekday_name
		dataType: string
		lineageTag: 09923cec-a74e-42cb-bf4d-74fe377d183c
		summarizeBy: none
		sourceColumn: weekday_name
		sortByColumn: weekday_number

		annotation SummarizationSetBy = Automatic

	/// Чи день припадає на вихідні (субота або неділя).
	column is_weekend
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 166eee61-56d7-4840-81b4-dd9037cf5235
		summarizeBy: none
		sourceColumn: is_weekend

		annotation SummarizationSetBy = Automatic

	partition 'marts dim_date' = m
		mode: import
		source =
				let
				  Source = PostgreSQL.Database("localhost", "cdpr_hub"),
				  #"Navigation 1" = Source{[Schema = "marts", Item = "dim_date"]}[Data]
				in
				  #"Navigation 1"

	annotation PBI_ResultType = Table

