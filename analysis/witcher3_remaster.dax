// =====================================================================
// The Witcher 3: Wild Hunt (appid 292030) - Remastered launch analysis
//
// Context: "The Witcher 3: Wild Hunt - Remastered" shipped as a free
// upgrade on 2026-09-29 (event W3013 in config/events.csv). Reviews
// spiked the same day: 3,730 reviews / 966 negative, with Positive %
// dropping from ~96% to 74%.
//
// Run against the CDPR_Health_Hub semantic model (Power BI Desktop or
// the published model). All queries anchor on the last date that has
// review data instead of TODAY(), so they stay correct between
// refreshes. Read-only: no model objects are created or changed.
//
// Caveat on every topic share: [Topic Share of Negative %] divides
// 'Review Topics Daily'[negative_reviews] by
// 'Reviews Daily'[topic_scanned_negative_reviews]. One review can carry
// several topics, so shares do NOT sum to 100%. The "No topic found"
// row is the share of scanned negative reviews the keyword dictionary
// did not match, so a drop there means better matching, not less
// negativity.
// =====================================================================


// ---------------------------------------------------------------------
// Query 1 - Topic mix of negative reviews: last 30 days vs the 90 days
//           before them.
//
// Shows how the composition of complaints shifted. Delta is in
// percentage points. Note that the prior-90-day window contains the
// 2026-09-29 launch spike, so it is not a quiet baseline - use Query 3
// for a clean before / launch / after split.
// ---------------------------------------------------------------------
DEFINE
    VAR _App = 292030
    VAR _Last = CALCULATE ( MAX ( 'Reviews Daily'[date] ), ALL ( 'Date' ), 'Game'[appid] = _App )
    VAR _S30 = _Last - 29
    VAR _E90 = _S30 - 1
    VAR _S90 = _E90 - 89
EVALUATE
VAR _T =
    ADDCOLUMNS (
        VALUES ( 'Topic'[topic_label] ),
        "Neg mentions 30d", CALCULATE ( [Topic Mentions (Negative)], 'Game'[appid] = _App, DATESBETWEEN ( 'Date'[date], _S30, _Last ) ),
        "Share 30d", CALCULATE ( [Topic Share of Negative %], 'Game'[appid] = _App, DATESBETWEEN ( 'Date'[date], _S30, _Last ) ),
        "Neg mentions prev90d", CALCULATE ( [Topic Mentions (Negative)], 'Game'[appid] = _App, DATESBETWEEN ( 'Date'[date], _S90, _E90 ) ),
        "Share prev90d", CALCULATE ( [Topic Share of Negative %], 'Game'[appid] = _App, DATESBETWEEN ( 'Date'[date], _S90, _E90 ) )
    )
RETURN
    ADDCOLUMNS ( _T, "Delta pp", ( [Share 30d] - [Share prev90d] ) * 100 )
ORDER BY [Share 30d] DESC


// ---------------------------------------------------------------------
// Query 2 - Negative reviews per day for the last 45 days.
//
// Daily shape of the launch reaction and the decay afterwards.
// The last row is the current, incomplete day: exclude it when
// comparing day-over-day.
// ---------------------------------------------------------------------
DEFINE
    VAR _App = 292030
    VAR _Last = CALCULATE ( MAX ( 'Reviews Daily'[date] ), ALL ( 'Date' ), 'Game'[appid] = _App )
    VAR _S45 = _Last - 44
EVALUATE
ADDCOLUMNS (
    CALCULATETABLE ( VALUES ( 'Date'[date] ), DATESBETWEEN ( 'Date'[date], _S45, _Last ) ),
    "Negative Reviews", CALCULATE ( [Negative Reviews], 'Game'[appid] = _App ),
    "Reviews", CALCULATE ( [Reviews], 'Game'[appid] = _App ),
    "Positive %", CALCULATE ( [Positive %], 'Game'[appid] = _App )
)
ORDER BY 'Date'[date]


// ---------------------------------------------------------------------
// Query 3 - Three fixed windows around the Remastered launch:
//             Before  2026-07-08 .. 2026-09-28  (83 days, quiet baseline)
//             Launch  2026-09-29 .. 2026-10-05  (7 days, launch week)
//             After   2026-10-06 .. 2026-11-03  (29 days, settled)
//           2026-11-04 is excluded: the current day is still incomplete.
//
// One row per window: overall health ([Negative Reviews], [Positive %],
// [Negative from Newcomers %]) plus [Topic Mentions (Negative)] and
// [Topic Share of Negative %] for each topic. "Scanned Negative" is the
// denominator the shares use, kept visible so the shares can be checked.
//
// Windows are hardcoded on purpose: they are tied to event W3013 and
// must not move when new data arrives.
//
// Overlapping event: Steam Autumn Sale 2026 (ST015, 2026-10-01 ..
// 2026-10-08) falls inside the Launch window and the first three days of
// After, so new buyers from the sale are a competing explanation for
// part of the launch-week reaction. [Negative from Newcomers %] is the
// column to read against that: if the sale were driving the negativity,
// the share of negative reviews written under 2 hours of playtime would
// rise, not fall.
// ---------------------------------------------------------------------
DEFINE
    VAR _App = 292030
    VAR _Windows =
        DATATABLE (
            "Window", STRING,
            "From", DATETIME,
            "To", DATETIME,
            {
                { "1 Before", "2026-07-08", "2026-09-28" },
                { "2 Launch", "2026-09-29", "2026-10-05" },
                { "3 After",  "2026-10-06", "2026-11-03" }
            }
        )
EVALUATE
GENERATE (
    _Windows,
    VAR _F = [From]
    VAR _T = [To]
    RETURN
        ROW (
            "Negative Reviews",        CALCULATE ( [Negative Reviews],           'Game'[appid] = _App, DATESBETWEEN ( 'Date'[date], _F, _T ) ),
            "Positive %",              CALCULATE ( [Positive %],                 'Game'[appid] = _App, DATESBETWEEN ( 'Date'[date], _F, _T ) ),
            "Neg from Newcomers %",    CALCULATE ( [Negative from Newcomers %],  'Game'[appid] = _App, DATESBETWEEN ( 'Date'[date], _F, _T ) ),
            "Scanned Negative",        CALCULATE ( SUM ( 'Reviews Daily'[topic_scanned_negative_reviews] ), 'Game'[appid] = _App, DATESBETWEEN ( 'Date'[date], _F, _T ) ),
            "Bugs mentions",           CALCULATE ( [Topic Mentions (Negative)],  'Topic'[topic] = "bugs",        'Game'[appid] = _App, DATESBETWEEN ( 'Date'[date], _F, _T ) ),
            "Bugs share",              CALCULATE ( [Topic Share of Negative %],  'Topic'[topic] = "bugs",        'Game'[appid] = _App, DATESBETWEEN ( 'Date'[date], _F, _T ) ),
            "Performance mentions",    CALCULATE ( [Topic Mentions (Negative)],  'Topic'[topic] = "performance", 'Game'[appid] = _App, DATESBETWEEN ( 'Date'[date], _F, _T ) ),
            "Performance share",       CALCULATE ( [Topic Share of Negative %],  'Topic'[topic] = "performance", 'Game'[appid] = _App, DATESBETWEEN ( 'Date'[date], _F, _T ) ),
            "Price mentions",          CALCULATE ( [Topic Mentions (Negative)],  'Topic'[topic] = "price",       'Game'[appid] = _App, DATESBETWEEN ( 'Date'[date], _F, _T ) ),
            "Price share",             CALCULATE ( [Topic Share of Negative %],  'Topic'[topic] = "price",       'Game'[appid] = _App, DATESBETWEEN ( 'Date'[date], _F, _T ) ),
            "Story mentions",          CALCULATE ( [Topic Mentions (Negative)],  'Topic'[topic] = "story",       'Game'[appid] = _App, DATESBETWEEN ( 'Date'[date], _F, _T ) ),
            "Story share",             CALCULATE ( [Topic Share of Negative %],  'Topic'[topic] = "story",       'Game'[appid] = _App, DATESBETWEEN ( 'Date'[date], _F, _T ) ),
            "Content mentions",        CALCULATE ( [Topic Mentions (Negative)],  'Topic'[topic] = "content",     'Game'[appid] = _App, DATESBETWEEN ( 'Date'[date], _F, _T ) ),
            "Content share",           CALCULATE ( [Topic Share of Negative %],  'Topic'[topic] = "content",     'Game'[appid] = _App, DATESBETWEEN ( 'Date'[date], _F, _T ) ),
            "No topic mentions",       CALCULATE ( [Topic Mentions (Negative)],  'Topic'[topic] = "none",        'Game'[appid] = _App, DATESBETWEEN ( 'Date'[date], _F, _T ) ),
            "No topic share",          CALCULATE ( [Topic Share of Negative %],  'Topic'[topic] = "none",        'Game'[appid] = _App, DATESBETWEEN ( 'Date'[date], _F, _T ) )
        )
)
ORDER BY [Window]
