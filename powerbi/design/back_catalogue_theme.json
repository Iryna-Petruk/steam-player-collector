{
  "name": "Back-Catalogue Health Hub (independent)",
  "dataColors": ["#B3122E", "#0E8A9A", "#6B7280", "#9AA0A6", "#C4C8CD", "#D4A017", "#3B5BA9", "#7A4E9C"],
  "background": "#FFFFFF",
  "foreground": "#1F2328",
  "tableAccent": "#B3122E",
  "good": "#1A7F37",
  "neutral": "#9AA0A6",
  "bad": "#B3122E",
  "maximum": "#B3122E",
  "center": "#F3F3F1",
  "minimum": "#0E8A9A",
  "textClasses": {
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#1F2328" },
    "title":   { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1F2328" },
    "header":  { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#1F2328" },
    "label":   { "fontFace": "Segoe UI", "fontSize": 10, "color": "#5F6368" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": false }],
        "dropShadow": [{ "show": false }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#1F2328" } }, "fontSize": 12 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F3F3F1" } }, "transparency": 0 }]
      }
    }
  }
}
