    "objects": {
      "vega": [
        {
          "properties": {
            "provider": {
              "expr": {
                "Literal": {
                  "Value": "'vegaLite'"
                }
              }
            },
            "jsonSpec": {
              "expr": {
                "Literal": {
                  "Value": "'{\n  \"$schema\": \"https://vega.github.io/schema/vega-lite/v5.json\",\n  \"data\": { \"name\": \"dataset\" },\n  \"transform\": [\n    { \"filter\": \"datum.type != ''platform_sale'' && isValid(datum.before) && isValid(datum.after)\" },\n    { \"calculate\": \"(datum.after - datum.before) * 100\", \"as\": \"change\" },\n    { \"calculate\": \"(datum.game == ''Cyberpunk 2077'' ? ''CP2077'' : ''TW3'') + '' · '' + datum.event + '' ('' + year(datum.date) + '')''\", \"as\": \"label\" },\n    { \"calculate\": \"datum.change < 0 ? ''fell'' : ''rose''\", \"as\": \"direction\" },\n    { \"calculate\": \"(datum.change >= 0 ? ''+'' : '''') + format(datum.change, ''.1f'') + '' pp''\", \"as\": \"change_text\" },\n    { \"calculate\": \"isValid(datum.net) ? (datum.net >= 0 ? ''+'' : '''') + format(datum.net, ''.1f'') + '' pp'' : ''pending (control data)''\", \"as\": \"net_text\" }\n  ],\n  \"encoding\": {\n    \"y\": {\n      \"field\": \"label\", \"type\": \"nominal\", \"title\": null,\n      \"sort\": { \"field\": \"change\", \"op\": \"min\", \"order\": \"ascending\" },\n      \"axis\": { \"domain\": false, \"ticks\": false, \"labelPadding\": 8,\n                \"labelFontSize\": 11, \"labelColor\": \"#1F2328\", \"labelLimit\": 320 }\n    },\n    \"tooltip\": [\n      { \"field\": \"event\", \"title\": \"Event\" },\n      { \"field\": \"game\", \"title\": \"Game\" },\n      { \"field\": \"date\", \"title\": \"Date\", \"type\": \"temporal\", \"format\": \"%d %b %Y\" },\n      { \"field\": \"before\", \"title\": \"Steam score, 4 weeks before\", \"format\": \".1%\" },\n      { \"field\": \"after\", \"title\": \"Steam score, first 2 weeks\", \"format\": \".1%\" },\n      { \"field\": \"change_text\", \"title\": \"Change\" },\n      { \"field\": \"net_text\", \"title\": \"Net of control games\" }\n    ]\n  },\n  \"layer\": [\n    {\n      \"mark\": { \"type\": \"rule\", \"strokeWidth\": 3 },\n      \"encoding\": {\n        \"x\": { \"field\": \"before\", \"type\": \"quantitative\", \"title\": null,\n               \"scale\": { \"zero\": false },\n               \"axis\": { \"format\": \".0%\", \"tickCount\": 6, \"domain\": false, \"ticks\": false,\n                         \"gridColor\": \"#EEEEEC\", \"labelColor\": \"#5F6368\", \"labelFontSize\": 11 } },\n        \"x2\": { \"field\": \"after\" },\n        \"color\": { \"field\": \"direction\", \"type\": \"nominal\", \"legend\": null,\n                   \"scale\": { \"domain\": [\"fell\", \"rose\"], \"range\": [\"#B3122E\", \"#5F6368\"] } }\n      }\n    },\n    {\n      \"mark\": { \"type\": \"circle\", \"size\": 70, \"color\": \"#C4C8CD\", \"opacity\": 1 },\n      \"encoding\": { \"x\": { \"field\": \"before\", \"type\": \"quantitative\" } }\n    },\n    {\n      \"mark\": { \"type\": \"circle\", \"size\": 110, \"opacity\": 1 },\n      \"encoding\": {\n        \"x\": { \"field\": \"after\", \"type\": \"quantitative\" },\n        \"color\": { \"field\": \"direction\", \"type\": \"nominal\", \"legend\": null,\n                   \"scale\": { \"domain\": [\"fell\", \"rose\"], \"range\": [\"#B3122E\", \"#5F6368\"] } }\n      }\n    },\n    {\n      \"transform\": [{ \"filter\": \"datum.direction == ''fell''\" }],\n      \"mark\": { \"type\": \"text\", \"align\": \"right\", \"dx\": -9, \"fontSize\": 11, \"fontWeight\": 600, \"color\": \"#B3122E\" },\n      \"encoding\": { \"x\": { \"field\": \"after\", \"type\": \"quantitative\" }, \"text\": { \"field\": \"change_text\" } }\n    },\n    {\n      \"transform\": [{ \"filter\": \"datum.direction == ''rose''\" }],\n      \"mark\": { \"type\": \"text\", \"align\": \"left\", \"dx\": 9, \"fontSize\": 11, \"fontWeight\": 600, \"color\": \"#5F6368\" },\n      \"encoding\": { \"x\": { \"field\": \"after\", \"type\": \"quantitative\" }, \"text\": { \"field\": \"change_text\" } }\n    }\n  ],\n  \"config\": { \"view\": { \"stroke\": null }, \"font\": \"Segoe UI\", \"background\": null }\n}'"
                }
